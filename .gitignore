# ── Data folders ──────────────────────────────────────────────────────────────
# BMP image stacks (synthetic, real, and generated data)
synthetic_data/
real_data/
generated_data/
 
# DREAM.3D output folders
data/persistent_diagram/
data/persistent_images/
 
# ── Large binary outputs ───────────────────────────────────────────────────────
# Pickle files (PCA reducers, persistence images)
*.pkl
 
# CSV files from PH pipeline (large)
data/pca_results/*.csv
data/persistent_images/**/*.csv
 
# ── Model weights ──────────────────────────────────────────────────────────────
# Saved GAN and CNN model checkpoints (can be large)
1_GAN/save_model/
2_CNN/save_model/
 
# ── Training process images ────────────────────────────────────────────────────
# Epoch preview images from GAN training
1_GAN/Process_Images/
 
# ── Python cache ──────────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
.pytest_cache/
 
# ── Conda / virtual environments ──────────────────────────────────────────────
.conda/
.venv/
env/
 
# ── Jupyter notebooks checkpoints ────────────────────────────────────────────
.ipynb_checkpoints/
 
# ── OS files ──────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
 
# ── What IS tracked (code and small outputs) ──────────────────────────────────
# Keeping:
#   *.py scripts
#   *.md README
#   data/pca_results/*.png  (PCA plots — small, useful to show)
#   log.dat files           (training logs — small text)
#   moving_ave.png          (CNN loss plot)
#   *.png loss plots from 1_GAN/
!data/pca_results/*.png
!1_GAN/*.png
!2_CNN/*.png
 
 # 0_ParaView test artifacts (regenerable, large)
0_PRV/*.vtk
0_PRV/*_slices/
0_PRV/test_slices*/
0_PRV/test_preprocess_out/
0_PRV/__pycache__/
# ── Additional data/output folders ──
generated_data_*/
1_GAN/save_model_*/
4_CNNCT/s_values*.csv
4_CNNCT/s_value_report*.csv
4_CNNCT/*_connectivity.csv
4_CNNCT/ceiling_metrics_cache.csv
4_CNNCT/ceiling_bar.png
4_CNNCT/__pycache__/
1_GAN/log.dat
# ── 5_TAU pipeline outputs (large / generated) ──
5_TAU/save_model/
5_TAU/tau_labels.csv
5_TAU/__pycache__/
# ── Dataset inspection outputs (derived from external data, not to be committed) ──
new_dataset_slices.png
new_dataset_matbox.png
# ── Multi-dataset config: local paths (machine-specific, never commit) ──
configs/local_paths.yaml
# ── Cathode crop output directories (gitignored like generated_data/) ──
cathode_crops_*/
# ── Cathode run generated structure directories ──
generated_cathode_*/
# ── Cathode run analysis outputs ──
4_CNNCT/cathode_run0_memo.csv
4_CNNCT/cathode_s1_*_metrics.csv
4_CNNCT/s_values_cathode_*.csv
# ── Run-specific log files (untracked like run*_output.log) ──
1_GAN/cathode_*.log
# ── Root-level artifacts when training is run from repo root (not 1_GAN/) ──
save_model/
Process_Images/
log.dat
pipeline.log
